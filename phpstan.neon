# PHPStan configuration for PooCommerce Payments

includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - phpstan-baseline.neon
    # Plugins we integrate with. We don't declare a minimum version for any of them, so check against their latest release.
    - vendor/poocommerce/php-stubs/stubs/automatewoo/latest.neon
    - vendor/poocommerce/php-stubs/stubs/mailpoet/latest.neon
    - vendor/poocommerce/php-stubs/stubs/poocommerce-bookings/latest.neon
    - vendor/poocommerce/php-stubs/stubs/poocommerce-deposits/latest.neon
    - vendor/poocommerce/php-stubs/stubs/poocommerce-points-and-rewards/latest.neon
    - vendor/poocommerce/php-stubs/stubs/poocommerce-pre-orders/latest.neon
    - vendor/poocommerce/php-stubs/stubs/poocommerce-product-addons/latest.neon

parameters:
    level: 5
    phpVersion: 70400 # PHP 7.4
    reportUnmatchedIgnoredErrors: true
    reportIgnoresWithoutComments: true
    dynamicConstantNames:
        - 'WC_VERSION'
        - 'WCPAY_VERSION_NUMBER'
        - 'WC_ADMIN_VERSION_NUMBER'
        - 'MAILPOET_VERSION'
        - 'WC_DEPOSITS_VERSION'
        - 'Automattic\Jetpack\Connection\Package_Version::PACKAGE_VERSION'

    # Files and directories to analyze
    paths:
        - poocommerce-payments.php
        - includes
        - src

    # Files and directories to exclude
    excludePaths:
        analyse:
            - includes/in-person-payments/templates
            - includes/subscriptions
            - includes/compat/subscriptions

    scanFiles:
        - vendor/php-stubs/poocommerce-stubs/poocommerce-stubs.php
        - vendor/php-stubs/poocommerce-stubs/poocommerce-packages-stubs.php
        - dev/phpstan-wcpay-constants.php
        - dev/phpstan-abilities-stubs.php

    scanDirectories:
        - vendor/poocommerce/subscriptions-core
